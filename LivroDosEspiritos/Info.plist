<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Obrigatório pela Meta (desde jan/2023) para abrir o editor de Instagram Stories.
	     Crie um app em https://developers.facebook.com e cole o App ID aqui.
	     Associe o Bundle ID com.alliston.LivroEspiritos (ou o do target) ao app. -->
	<key>FacebookAppID</key>
	<string></string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.alliston.LivroDosEspiritos</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>livrodosespiritos</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
